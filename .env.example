# ------------------------------------------------------------------
# HealthMate AI - konfigurimi
# Kopjo këtë skedar si ".env" dhe plotëso vetëm atë që të duhet.
# ------------------------------------------------------------------

# Aplikacioni FUNKSIONON PA ASNJË ÇELËS.
# Si parazgjedhje përdoret Pollinations.ai (falas, pa regjistrim).
#
# Nëse dëshiron një model më të shpejtë/më të fortë, vendos një nga
# çelësat më poshtë (të gjithë kanë plan FALAS). Përdoret i pari që gjendet,
# sipas kësaj radhe: Groq -> Gemini -> OpenRouter -> Pollinations.

# Groq (shumë i shpejtë) - https://console.groq.com/keys
# Modele falas: openai/gpt-oss-120b (më i miri) ose openai/gpt-oss-20b (më i shpejti)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Modeli që lexon fotot e fletëve të analizave (falas)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (modele ":free") - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pollinations (pa çelës). Mund të ndryshosh modelin nëse dëshiron.
POLLINATIONS_MODEL=openai

# Porti ku hapet aplikacioni
PORT=8000
